# Add these server-only values to backend/.env alongside the existing database,
# SMTP and authentication settings. Never expose the API secret in VITE_* values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Retained for reading documents uploaded before Cloudinary was enabled.
DOCUMENT_STORAGE_PATH=./private-documents

# Customer INR checkout. Start with Razorpay test keys. Server-only values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required for signed webhook notifications; checkout uses the two API keys above.
RAZORPAY_WEBHOOK_SECRET=

# Optional commission snapshot for NEW bookings only; existing commission records are preserved.
# Leave blank when no server-approved rule has been established. Unresolved payouts stay OnHold.
BOOKING_COMMISSION_PERCENT=
# Set false only when scripts/process-booking-jobs.js is run by an external scheduler.
BOOKING_JOBS_ENABLED=true

# Customer review and vendor response editing window, measured from creation.
# Owners can withdraw their reviews/responses at any time; moderator-hidden
# content cannot be edited to bypass moderation.
REVIEW_EDIT_DAYS=14

# Central media. Set the externally reachable API origin in production.
PUBLIC_API_URL=http://localhost:5000
MEDIA_MAX_MB=5
MEDIA_MAX_PER_ENTITY=30
MEDIA_RETENTION_DAYS=30
# False only when process-media-cleanup.js --apply runs via an external scheduler.
MEDIA_CLEANUP_ENABLED=true

# Content and support (SMTP settings above are reused)
SUPPORT_MAIL_JOBS_ENABLED=true
CMS_MAPS_ENABLED=false
# Canonical public website origin used by the XML sitemap
PUBLIC_SITE_URL=http://localhost:5173
