# Add these server-only values to backend/.env alongside the existing database,
# SMTP and authentication settings. Never expose the API secret in VITE_* values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Retained for reading documents uploaded before Cloudinary was enabled.
DOCUMENT_STORAGE_PATH=./private-documents

# Customer INR checkout. Start with Razorpay test keys. Server-only values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
